{
    "compilerOptions": {
        "module": "ES6",
        "target": "ES2022",
        "lib": ["dom", "ES2022"],
        "sourceMap": true,
        "rootDir": "../../",
        "outDir": "../../../build/webview",
        "strict": true,
        "skipLibCheck": true,
        "moduleResolution": "bundler"
    },
    "include": [
        "./**/*.ts",
        "../../types/**/*.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}