{
    "compilerOptions": {
        "module": "Node16",
        "target": "ES2022",
        "lib": ["dom", "ES2022"],
        "sourceMap": true,
        "rootDir": "src",
        "outDir": "dist",
        "strict": true,
        "skipLibCheck": true,
        "types": ["node", "mocha"],
        "moduleResolution": "node16"
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "src/ui/webview"
    ]
}