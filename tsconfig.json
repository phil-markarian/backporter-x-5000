{
    "compilerOptions": {
        "module": "Node16",
        "target": "ES2022",
        "lib": ["dom", "ES2022"],
        "sourceMap": true,
        "rootDir": "src",
        "outDir": "dist",
        "strict": true,
        "moduleResolution": "NodeNext",
        "composite": true
    },
    "include": ["src/**/*.ts"],
    "exclude": [
        "node_modules",
        "dist",
        "build",
        "src/ui/webview/**/*"  // Exclude webview from main compilation
    ]
}